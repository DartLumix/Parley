# Host UDP port. 4443 matches the client default, so "your-server"
# (no port) just works; 443 is the friendliest through firewalls if you
# prefer it — any port works as long as clients use the same one.
PARLEY_PORT=4443

# First boot only: creates the `admin` account when the database has no
# users. Set it, start the container once, then remove the line.
PARLEY_ADMIN_PASSWORD=change-me-before-first-boot

# Image to run. After `docker load -i parley-image-<version>.tar.gz`, the
# local tag is parley:<version> (and parley:latest). To pull from GHCR:
#   PARLEY_IMAGE=ghcr.io/dartlumix/parley:0.2.0
PARLEY_IMAGE=parley:latest
