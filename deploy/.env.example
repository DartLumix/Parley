# Host UDP port. 4443 matches the client default, so "your-server"
# (no port) just works; 443 is the friendliest through firewalls if you
# prefer it — any port works as long as clients use the same one.
PARLEY_PORT=4443

# Read-only presence API for a dashboard on this host
# (GET http://127.0.0.1:<port>/api/presence). Published to host loopback
# only; keep the bind at 127.0.0.1 unless the caller runs in a container
# of its own, in which case use the docker bridge address (usually
# 172.17.0.1) and set a token below.
PARLEY_PRESENCE_PORT=4444
PARLEY_PRESENCE_BIND=127.0.0.1

# Optional bearer token for the presence API: the caller sends
#   Authorization: Bearer <token>
# Leave empty when the bind stays on 127.0.0.1. Generate one with
# `openssl rand -hex 32`; the same value goes into the dashboard's config.
PARLEY_PRESENCE_TOKEN=

# First boot only: creates the `admin` account when the database has no
# users. Set it, start the container once, then remove the line.
PARLEY_ADMIN_PASSWORD=change-me-before-first-boot

# Image to run. After `docker load -i parley-image-<version>.tar.gz`, the
# local tag is parley:<version> (and parley:latest). To pull from GHCR:
#   PARLEY_IMAGE=ghcr.io/dartlumix/parley:0.2.0
PARLEY_IMAGE=parley:latest
